<% layout("/listings/layouts/boilerplate") %>

<style>
.error_background_wrapper {
    position: relative;
    width: 100%;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1rem;
}

.error_glass_container {
    background-color: rgba(255, 59, 48, 0.1);
    border: 1px solid rgba(255, 59, 48, 0.4);
    color: white;
    border-radius: 1.5rem;
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    padding: 3.5rem 4rem;
    width: 100%;
    max-width: 700px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4), inset 0 0 15px rgba(255, 59, 48, 0.2);
    text-align: center;
}

.error-title {
    font-size: 3rem;
    font-weight: 500;
    margin-bottom: 1rem;
    color: #ff3b30;
    font-family: 'Instrument Serif', serif;
}

.error-icon {
    font-size: 4rem;
    color: #ff3b30;
    margin-bottom: 1.5rem;
    opacity: 0.8;
}

.error-stack {
    background: rgba(0, 0, 0, 0.3);
    border-radius: 0.5rem;
    padding: 1.5rem;
    text-align: left;
    font-family: monospace;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    overflow-x: auto;
    margin-top: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.button__home {
    padding: 0.8rem 2.5rem;
    border-radius: 2rem;
    background: white;
    color: black;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: 0.3s;
    text-decoration: none;
    display: inline-block;
    margin-top: 2rem;
}
.button__home:hover {
    background: rgba(255,255,255,0.8);
    transform: translateY(-2px);
}
</style>

<div class="error_background_wrapper">
    <div class="error_glass_container">
        <i class="fa-solid fa-triangle-exclamation error-icon"></i>
        <h1 class="error-title">Oops! Something went wrong.</h1>
        <h4 class="text-white-50"><%= err.message %></h4>
        
        <div class="error-stack">
            <pre style="margin: 0; white-space: pre-wrap;"><%= err.stack %></pre>
        </div>

        <a href="/listings" class="button__home">Return Home</a>
    </div>
</div>