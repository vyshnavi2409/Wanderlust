<style>
.glass-alert {
    background: rgba(255, 255, 255, 0.1) !important;
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    color: white !important;
    border-radius: 1rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}
.glass-alert.alert-success {
    border-left: 4px solid #28eb3d !important;
}
.glass-alert.alert-danger {
    border-left: 4px solid #ff3b30 !important;
}
.glass-alert .btn-close {
    filter: invert(1) grayscale(100%) brightness(200%);
}
</style>

<% if(success && success.length) { %>
<div class="alert alert-success glass-alert alert-dismissible fade show col-6 offset-3 mt-3" role="alert">
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>

<% if(error && error.length) { %>
<div class="alert alert-danger glass-alert alert-dismissible fade show col-6 offset-3 mt-3" role="alert">
    <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>
