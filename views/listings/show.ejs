<% layout("/listings/layouts/boilerplate") %>

<style>
.show_background_wrapper {
    position: relative;
    width: 100%;
    min-height: 80vh;
    padding: 3rem 1rem;
}

.glass_container {
    margin: 0 auto;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: white;
    border-radius: 1.5rem;
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    padding: 3.5rem 4rem;
    width: 100%;
    max-width: 900px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4), inset 0 0 15px rgba(255, 255, 255, 0.1);
}

.listing-title {
    font-size: 3rem;
    font-weight: 500;
    margin-bottom: 2rem;
    color: white;
    font-family: 'Instrument Serif', serif;
    letter-spacing: 1px;
}

.listing-image {
    width: 100%;
    height: 450px;
    object-fit: cover;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    margin-bottom: 2rem;
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
}

.listing-details {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.8;
}
.listing-details strong {
    color: white;
}
.listing-price {
    font-size: 1.5rem;
    font-weight: 600;
    color: white;
    margin-top: 1rem;
}
.owner-tag {
    display: inline-block;
    background: rgba(255, 255, 255, 0.15);
    padding: 0.3rem 1rem;
    border-radius: 2rem;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255,255,255,0.2);
}

/* Glass Review Cards */
.review-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 1rem;
    padding: 1.5rem;
    color: white;
    margin-bottom: 1.5rem;
    transition: transform 0.3s ease, background 0.3s ease;
}
.review-card:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-3px);
}
.review-author {
    font-weight: 600;
    color: white;
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}
.review-comment {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
    margin-top: 1rem;
    line-height: 1.5;
}

/* Forms inside show */
.review-input {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: white;
    border-radius: 0.5rem;
    padding: 1rem;
    width: 100%;
    outline: none;
    font-size: 1rem;
}
.review-input:focus {
    border-color: white;
}

.button__action {
    padding: 0.8rem 2.5rem;
    border-radius: 2rem;
    background: white;
    color: black;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: 0.3s;
    text-decoration: none;
    display: inline-block;
    text-align: center;
}
.button__action:hover {
    background: rgba(255,255,255,0.8);
    transform: translateY(-2px);
}
.button__danger {
    background: rgba(255, 59, 48, 0.8);
    color: white;
}
.button__danger:hover {
    background: rgba(255, 59, 48, 1);
}

.section-divider {
    border-color: rgba(255, 255, 255, 0.2);
    margin: 3rem 0;
}

@media (max-width: 768px) {
    .glass_container {
        padding: 2rem 1.5rem;
    }
    .listing-title {
        font-size: 2.2rem;
    }
}
</style>

<div class="show_background_wrapper">
    <div class="glass_container">
        
        <h1 class="listing-title"><%= findListing.title %></h1>
        
        <div class="owner-tag">
            <i class="fa-solid fa-user-circle"></i> Hosted by <strong>@<%= findListing.owner.username %></strong>
        </div>

        <img 
            src="<%= findListing.image?.url || 'https://images.unsplash.com/photo-1501785888041-af3ef285b470' %>" 
            class="listing-image" 
            alt="listing_image">
  
        <div class="listing-details">
            <p><%= findListing.description %></p>
            
            <div class="row mt-4">
                <div class="col-md-6">
                    <p><i class="fa-solid fa-location-dot me-2"></i> <%= findListing.location %></p>
                    <p><i class="fa-solid fa-globe me-2"></i> <%= findListing.country %></p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="listing-price">&#8377; <%= findListing.price ? findListing.price.toLocaleString("en-IN") : "N/A" %> / night</p>
                </div>
            </div>
        </div>

        <% if(currUser && findListing.owner._id.equals(currUser._id)) { %>
        <div class="d-flex gap-3 mt-4">
            <a href="/listings/<%= findListing._id %>/edit" class="button__action">Edit Listing</a>
            <form method="POST" action="/listings/<%= findListing._id %>?_method=DELETE" style="margin: 0;">
                <button class="button__action button__danger">Delete</button>
            </form>
        </div>
        <% } %>
        
        <hr class="section-divider">
        
        <% if(currUser) { %>
        <div class="mb-5">
            <h4 class="mb-4" style="font-family: 'Instrument Serif', serif; font-size: 2rem;">Leave a Review</h4>
            <form action="/listings/<%= findListing.id %>/reviews" method="POST" novalidate class="needs-validation">
                
                <div class="mb-4">
                    <label class="form-label text-white-50">Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                
                <div class="mb-4">
                    <label for="comment" class="form-label text-white-50">Comments</label>
                    <textarea 
                        name="review[comment]"
                        id="comment"
                        cols="30"
                        rows="4"
                        class="review-input"
                        placeholder="Share your experience..."
                        required></textarea>
                    <div class="invalid-feedback">Please add some comments for review</div>
                </div>
                
                <button class="button__action">Submit Review</button>
            </form>
        </div>
        <% } %>

        <% if(findListing.reviews.length > 0) { %>
            <h4 class="mb-4" style="font-family: 'Instrument Serif', serif; font-size: 2rem;">Guest Reviews</h4>
            <div class="row">
                <% for(review of findListing.reviews) { %>
                <div class="col-md-6">
                    <div class="review-card">
                        <div class="review-author">
                            <i class="fa-solid fa-circle-user"></i> @<%= review.author.username %>
                        </div>
                        <p class="starability-result mb-1" data-rating="<%= review.rating %>"></p>
                        <p class="review-comment"><%= review.comment %></p>

                        <% if(currUser && review.author._id.equals(currUser._id)) { %>
                        <form class="mt-3" method="POST" action="/listings/<%= findListing.id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn btn-sm btn-outline-danger" style="border-radius: 1rem;">Delete</button>
                        </form>
                        <% } %>
                    </div>
                </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="text-center text-white-50 my-5">
                <i class="fa-regular fa-comment-dots" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;"></i>
                <h5>No reviews yet</h5>
                <p>Be the first to share your experience!</p>
            </div>
        <% } %>

    </div>
</div>